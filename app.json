{
  "expo": {
    "name": "DolarBlue",
    "slug": "dolar-blue",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android"
    ],
    "android": {
      "package": "com.dolarblue"
    },
    "ios": {
      "bundleIdentifier": "com.dolarblue",
      "supportsTablet": false
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "plugins": [
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#25292e",
          "sounds": []
        }
      ]
    ]
  }
}
