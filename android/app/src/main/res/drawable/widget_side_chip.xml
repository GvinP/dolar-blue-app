<?xml version="1.0" encoding="utf-8"?>
<!--
  Chip del selector venta/compra. Surface elevado sobre la tarjeta para que se lea
  como algo que se toca, sin competir con el ámbar del botón de refresh.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_surface_elevated" />
    <corners android:radius="100dp" />
</shape>
