<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget en 2x1. A ese tamaño no entra el bloque de dos líneas (precio + "Compra"),
  así que cada cotización usa el mismo renglón que las filas de "Otras cotizaciones"
  en HomeScreen: nombre · venta · pill. Misma tarjeta `surface` con borde y radio 20.

  El root es transparente y `match_parent`; la tarjeta va `wrap_content` centrada.
  El host siempre estira el root a la celda completa, así que ese wrap es lo que
  hace que la tarjeta *visible* mida lo que mide el contenido en lugar de inflarse
  hasta el alto de la celda.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_card"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="9dp"
        android:paddingBottom="8dp">

        <!-- ── Slot 1 (siempre visible) ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/slot1_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:fontFamily="@font/figtree_bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp"
                android:textColor="@color/widget_text" />

            <!-- Columna del precio: el tag "compra" sólo aparece cuando no hay venta. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/slot1_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/martian_mono_bold"
                    android:maxLines="1"
                    android:textSize="13sp"
                    android:textColor="@color/widget_text" />

                <TextView
                    android:id="@+id/slot1_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/figtree_bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:textSize="8sp"
                    android:textColor="@color/widget_text_muted"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/slot1_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_neutral"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:fontFamily="@font/figtree_bold"
                android:maxLines="1"
                android:textSize="10sp"
                android:textColor="@color/widget_text_muted" />
        </LinearLayout>

        <!-- ── Separador (oculto si slot2 no está configurado) ──
             TextView y no View a propósito: RemoteViews sólo infla clases marcadas
             con @RemoteView (FrameLayout, LinearLayout, TextView, ImageView…), y
             android.view.View no está en esa lista. Cambiarlo por <View> hace que el
             launcher falle con "Can't load widget" en tiempo de ejecución — el build
             pasa igual, así que no hay red de seguridad más que este comentario. -->
        <TextView
            android:id="@+id/slot2_separator"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@color/widget_border" />

        <!-- ── Slot 2 (oculto si no está configurado) ── -->
        <LinearLayout
            android:id="@+id/slot2_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/slot2_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:fontFamily="@font/figtree_bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp"
                android:textColor="@color/widget_text" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/slot2_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/martian_mono_bold"
                    android:maxLines="1"
                    android:textSize="13sp"
                    android:textColor="@color/widget_text" />

                <TextView
                    android:id="@+id/slot2_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/figtree_bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.06"
                    android:maxLines="1"
                    android:textSize="8sp"
                    android:textColor="@color/widget_text_muted"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/slot2_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_neutral"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:fontFamily="@font/figtree_bold"
                android:maxLines="1"
                android:textSize="10sp"
                android:textColor="@color/widget_text_muted" />
        </LinearLayout>

        <!-- ── Pie: "Actualizado hace Xm" + botón de refresh ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/updated_at"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/figtree_regular"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="9sp"
                android:textColor="@color/widget_text_muted" />

            <!-- Ámbar: es la única acción del widget, mismo rol que el accent en la app. -->
            <TextView
                android:id="@+id/refresh_button"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:text="⟳"
                android:textSize="14sp"
                android:textColor="@color/widget_accent" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
