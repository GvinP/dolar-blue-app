<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget en el mismo lenguaje visual que HomeScreen: tarjeta `surface` con borde
  y radio 20, label en mayúsculas `textMuted`, precio en la tipografía ticker y
  el delta en una pill verde/roja (ver components/DeltaPill.tsx).

  El root es transparente y `match_parent`; la tarjeta va `wrap_content` centrada.
  El host siempre estira el root a la celda completa, así que ese wrap es lo que
  hace que la tarjeta *visible* mida lo que mide el contenido en lugar de inflarse
  hasta el alto de la celda (era el "está el doble de grande" del reporte).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_card"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- ── Slot 1 (siempre visible) ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/slot1_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:fontFamily="@font/figtree_bold"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="10sp"
                android:textColor="@color/widget_text_muted" />

            <TextView
                android:id="@+id/slot1_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_neutral"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:fontFamily="@font/figtree_bold"
                android:maxLines="1"
                android:textSize="10sp"
                android:textColor="@color/widget_text_muted" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal"
            android:gravity="bottom">

            <TextView
                android:id="@+id/slot1_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/martian_mono_bold"
                android:maxLines="1"
                android:textSize="17sp"
                android:textColor="@color/widget_text" />

            <TextView
                android:id="@+id/slot1_sub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:layout_marginBottom="2dp"
                android:fontFamily="@font/figtree_regular"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="10sp"
                android:textColor="@color/widget_text_muted" />
        </LinearLayout>

        <!-- ── Separador (oculto si slot2 no está configurado) ── -->
        <View
            android:id="@+id/slot2_separator"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="9dp"
            android:background="@color/widget_border" />

        <!-- ── Slot 2 (oculto si no está configurado) ── -->
        <LinearLayout
            android:id="@+id/slot2_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/slot2_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:fontFamily="@font/figtree_bold"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="10sp"
                    android:textColor="@color/widget_text_muted" />

                <TextView
                    android:id="@+id/slot2_pct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_pill_neutral"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:fontFamily="@font/figtree_bold"
                    android:maxLines="1"
                    android:textSize="10sp"
                    android:textColor="@color/widget_text_muted" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/slot2_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/martian_mono_bold"
                    android:maxLines="1"
                    android:textSize="17sp"
                    android:textColor="@color/widget_text" />

                <TextView
                    android:id="@+id/slot2_sub"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:layout_marginBottom="2dp"
                    android:fontFamily="@font/figtree_regular"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="10sp"
                    android:textColor="@color/widget_text_muted" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Pie: "Actualizado hace Xm" + botón de refresh ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/updated_at"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/figtree_regular"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="9sp"
                android:textColor="@color/widget_text_muted" />

            <!-- Ámbar: es la única acción del widget, mismo rol que el accent en la app. -->
            <TextView
                android:id="@+id/refresh_button"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:text="⟳"
                android:textSize="15sp"
                android:textColor="@color/widget_accent" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
