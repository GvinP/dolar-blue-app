<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#25292e"
    android:padding="12dp">

    <!-- Основной контент (marginEnd освобождает место под кнопку рефреша, чтобы не наезжала на процент) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="36dp"
        android:orientation="vertical">

        <!-- Dólar Blue -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/blue_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dólar Blue"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#ffffff" />

                <TextView
                    android:id="@+id/blue_porcentaje"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#808080" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="C "
                    android:textSize="11sp"
                    android:textColor="#808080" />

                <TextView
                    android:id="@+id/blue_compra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#00ff83" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  V "
                    android:textSize="11sp"
                    android:textColor="#808080" />

                <TextView
                    android:id="@+id/blue_venta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#ff6b6b" />
            </LinearLayout>
        </LinearLayout>

        <!-- Separador (TextView, no View — RemoteViews no soporta android.view.View plano) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#3a3f47"
            android:layout_marginBottom="8dp" />

        <!-- Dólar Oficial -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/oficial_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dólar Oficial"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="#ffffff" />

                <TextView
                    android:id="@+id/oficial_porcentaje"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#808080" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="C "
                    android:textSize="11sp"
                    android:textColor="#808080" />

                <TextView
                    android:id="@+id/oficial_compra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#00ff83" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  V "
                    android:textSize="11sp"
                    android:textColor="#808080" />

                <TextView
                    android:id="@+id/oficial_venta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#ff6b6b" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Кнопка обновления (открывает приложение) -->
    <TextView
        android:id="@+id/refresh_button"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:gravity="center"
        android:text="⟳"
        android:textColor="#808080"
        android:textSize="18sp" />

</RelativeLayout>
